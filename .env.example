# Copy to .env (which is gitignored) and fill in locally.
# NEVER put a private key, passphrase, seed phrase or API secret in this file
# or in .env -- .env is for paths and flags only.

# Public DID of the root agent. Public by construction; safe to commit once you
# choose to put it in config/agent.example.yaml instead.
FLOPOFFICE_ROOT_AGENT_DID=

# Path to the encrypted keystore. MUST live outside the repository.
# The keystore is not read by any M1 code path.
FLOPOFFICE_KEYSTORE=~/.flopoffice/keys/root_agent.pem

# Ledger location. Gitignored by extension.
FLOPOFFICE_LEDGER=./flopoffice.sqlite

# dev | test | prod  -- guards ephemeral key generation and write paths.
FLOPOFFICE_ENV=dev

# Base URL of a SELF-HOSTED Technocore instance for integration tests.
# Writes are refused unless this points at localhost/127.0.0.1.
# Leave unset to skip integration tests that need a live server.
TECHNOCORE_BASE_URL=

# Must be set to exactly "1" for the client to attempt ANY write, and even then
# only against a loopback host. Public technocore.chat is hard-blocked in code.
FLOPOFFICE_ALLOW_LOCAL_WRITE=0
