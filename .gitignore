# ---------------------------------------------------------------
# Secret material. Nothing below this line may ever be committed.
# ---------------------------------------------------------------
*.key
*.pem
*.jwk
*.p8
*.pk8
*.p12
*.pfx
*.keystore
# NOTE: a bare `keystore*` here silently excluded identity/keystore.py from the
# initial commit (git applies unanchored globs to basenames at any depth). Key
# names are covered by the extension rules above and by tools/secret_scan.py; do
# not re-add an unanchored prefix glob that can eat source files.
identity.pem
.env
.env.*
!.env.example
secrets/
keys/
.secrets/
*.seed
*.mnemonic

# Local ledger databases (may contain task metadata)
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# ---------------------------------------------------------------
# Ordinary Python noise
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.coverage
htmlcov/
.DS_Store
/keystore.json
/keystore.d/
